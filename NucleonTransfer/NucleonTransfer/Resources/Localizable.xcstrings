{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "Folder download row: name and file count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (%lld)" : {
      "comment" : "Transfers section header with row count: “Failed (3)”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$lld)"
          }
        }
      }
    },
    "%@ (Error %@)" : {
      "comment" : "Proton’s own error sentence followed by its numeric error code",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (Error %2$@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Erro %2$@)"
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "Modified column: “Today at 14:32”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ às %2$@"
          }
        }
      }
    },
    "%@ left" : {
      "comment" : "Transfer time remaining, e.g. “12 min left”",
